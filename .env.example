# Copia a .env. Mismo valor para la BD embebida (npm run db:dev) y para docker compose up -d.
DATABASE_URL=postgres://hayai:hayai@localhost:54329/hayai

# API (server/) -- todo opcional
# PORT=3001
# NODE_ENV=production        # cookie Secure + sirve ./dist; en produccion ponlo siempre
# COOKIE_SECURE=false        # solo para probar un build de produccion por http en local
# TRUST_PROXY=1              # si hay un proxy inverso delante (para el limite por IP)
# LOGIN_IP_MAX=30            # intentos de login por IP cada 15 min

