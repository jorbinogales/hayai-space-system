# Copia a .env en el VPS y edita. NUNCA subas el .env a git.
# Clave de Postgres: genera una con  openssl rand -hex 24
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga
# Dominio que ya apunta (registro A/AAAA) a la IP del VPS
DOMAIN=hayai.tu-dominio.com   # solo se usa con --profile caddy

# --- Meta Lead Ads (opcional; apagado por defecto). Requisitos en el README, seccion "Meta Lead Ads" ---
META_LEADS_ENABLED=false
# META_APP_SECRET=      # secreto de la app de Meta (firma del webhook)
# META_VERIFY_TOKEN=    # texto que tu eliges y pegas en la config del webhook
# META_PAGE_TOKEN=      # token de la Pagina con permiso leads_retrieval (requiere revision de Meta)
# META_LEADS_OWNER=Elis,Jorbi,Leandro   # a quien se reparten los leads (equitativo); suma a quien quieras

# --- Cobros: a que socio pertenece cada cedula que aparece como "DOCUMENTO V-..." en los comprobantes ---
# Formato "documento=socio" separado por comas. Solo agrega los que falten (lo que edites luego en la app manda).
# Estas son cedulas personales: ponlas SOLO aqui, en el .env del VPS; nunca en el repo ni en documentos.
# RECEIVER_DOCUMENTS=V-00000000=Elis,V-00000000=Jorbi,V-00000000=Leandro

# --- Semaforo de sistemas de los clientes ---
# SYSTEMS_CHECK_MS=600000   # cada cuanto se verifican (ms). 0 apaga el vigilante (la verificacion manual sigue)

# --- Tasa BCV de la barra superior (opcional; ya funciona con los valores por defecto) ---
# BCV_SOURCES=https://ve.dolarapi.com/v1/dolares/oficial,https://ve.dolarapi.com/v1/dolares   # fuentes en orden
# BCV_REFRESH_MS=1800000   # cada cuanto se actualiza sola (ms). 0 la apaga (queda la ultima guardada)
