{
  "name": "hayai-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "db:dev": "node server/db/dev-db.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.mjs",
    "db:seed": "tsx --env-file-if-exists=.env server/src/seed.ts",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "start:server": "tsx --env-file-if-exists=.env server/src/index.ts",
    "dev:api": "node --env-file-if-exists=.env server/dev-prepare.mjs && npm run dev:server",
    "dev:all": "concurrently -k -n db,api,web -c cyan,green,magenta \"npm:db:dev\" \"npm:dev:api\" \"npm:dev\"",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test:server": "tsx --test server/test/api.test.ts server/test/v1.test.ts",
    "apikey": "tsx --env-file-if-exists=.env server/src/apikey-cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "embedded-postgres": "^16.14.0-beta.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.9"
  }
}
