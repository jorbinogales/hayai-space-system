# Copia a .env. Mismo valor para la BD embebida (npm run db:dev) y para docker compose up -d.
DATABASE_URL=postgres://hayai:hayai@localhost:54329/hayai

# API (server/) -- todo opcional
# PORT=3001
# NODE_ENV=production        # cookie Secure + sirve ./dist; en produccion ponlo siempre
# COOKIE_SECURE=false        # solo para probar un build de produccion por http en local
# TRUST_PROXY=1              # si hay un proxy inverso delante (para el limite por IP)
# LOGIN_IP_MAX=30            # intentos de login por IP cada 15 min

# Mapa del feed: geocodificacion de direcciones (todo opcional; ver README, "Mapa del feed")
# GEOCODER=nominatim         # nominatim (por defecto) | off (los items quedan pendientes y solo se fijan a mano)
# GEOCODER_URL=https://nominatim.openstreetmap.org   # o un Nominatim propio
# GEOCODER_USER_AGENT=HAYAI-Space/1.0 (+https://space.hayai.com.ve)   # Nominatim exige identificar la aplicacion
# GEOCODER_MIN_MS=1100       # espera entre consultas (con el servidor publico nunca menos de 1000)
# VITE_MAP_TILES=            # otras teselas del mapa (solo en el build del front): https://.../{z}/{x}/{y}.png
