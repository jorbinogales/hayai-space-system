# Copia a .env. Mismo valor para la BD embebida (npm run db:dev) y para docker compose up -d.
DATABASE_URL=postgres://hayai:hayai@localhost:54329/hayai

# API (server/) -- todo opcional
# PORT=3001
# NODE_ENV=production        # cookie Secure + sirve ./dist; en produccion ponlo siempre
# COOKIE_SECURE=false        # solo para probar un build de produccion por http en local
# TRUST_PROXY=1              # si hay un proxy inverso delante (para el limite por IP)
# LOGIN_IP_MAX=30            # intentos de login por IP cada 15 min

# Acciones sugeridas por IA en el feed (oportunidades e ideas). Sin DEEPSEEK_API_KEY no hay IA y todo queda apagado.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT_MS=45000
# Mapa del feed: geocodificacion de direcciones (todo opcional; ver README, "Mapa del feed")
# GEOCODER=nominatim         # nominatim (por defecto) | mapbox | off (los items quedan pendientes y solo se fijan a mano)
# GEOCODER_URL=https://nominatim.openstreetmap.org   # otra URL base del proveedor elegido (un Nominatim propio...). NOMINATIM_URL / MAPBOX_URL mandan sobre esta
# GEOCODER_USER_AGENT=HAYAI-Space/1.0 (+https://space.hayai.com.ve)   # Nominatim exige identificar la aplicacion
# GEOCODER_RESPALDO=nominatim   # con GEOCODER=mapbox: si da solo la zona o nada, se prueba Nominatim (NOMINATIM_URL; max 1 consulta/s). off lo apaga
# GEOCODER_MIN_MS=1100       # espera entre consultas (Nominatim publico: nunca menos de 1000; Mapbox: 100 por defecto)
# --- Mapbox (opcional; GEOCODER=mapbox y/o MAP_TILES=mapbox). El token SOLO va aqui, en el servidor: nunca en el repo ni en el front ---
# MAPBOX_PUBLIC_TOKEN=       # token PUBLICO (pk....) con solo scopes publicos; uno secreto (sk....) se rechaza. Restringelo a https://space.hayai.com.ve en Mapbox
# MAPBOX_PERMANENT=false     # true = geocodificacion "permanente" de Mapbox (necesaria para GUARDAR resultados segun sus terminos; puede requerir plan)
# MAP_TILES=osm              # osm (por defecto) | mapbox: de donde salen las teselas del mapa (usa el mismo MAPBOX_PUBLIC_TOKEN)
# MAPBOX_STYLE=mapbox/streets-v12   # estilo de las teselas de Mapbox (usuario/estilo)
# VITE_MAP_TILES=            # fuerza otras teselas en el build del front (manda sobre MAP_TILES): https://.../{z}/{x}/{y}.png
