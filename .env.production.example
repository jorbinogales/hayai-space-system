# Copia a .env en el VPS y edita. NUNCA subas el .env a git.
# Clave de Postgres: genera una con  openssl rand -hex 24
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga
# Dominio que ya apunta (registro A/AAAA) a la IP del VPS
DOMAIN=hayai.tu-dominio.com   # solo se usa con --profile caddy

# --- Meta Lead Ads (opcional; apagado por defecto). Requisitos en el README, seccion "Meta Lead Ads" ---
META_LEADS_ENABLED=false
# META_APP_SECRET=      # secreto de la app de Meta (firma del webhook)
# META_VERIFY_TOKEN=    # texto que tu eliges y pegas en la config del webhook
# META_PAGE_TOKEN=      # token de la Pagina con permiso leads_retrieval (requiere revision de Meta)
# META_LEADS_OWNER=Elis,Jorbi,Leandro   # a quien se reparten los leads (equitativo); suma a quien quieras

# --- Webhook saliente de tareas asignadas a Leandro (Release 1.8.3 «Órbita fina IV»; apagado por defecto) ---
# La URL debe ser alcanzable desde el VPS. Requiere reiniciar el servicio tras cambiar estas variables.
# HAYAI_TASK_WEBHOOK_URL=https://TU-RECEPTOR/webhooks/space-tareas
# HAYAI_TASK_WEBHOOK_SECRET=<generar-uno-nuevo-en-el-VPS>
# HAYAI_TASK_WEBHOOK_OWNER=Leandro   # socio al que avisa (por nombre, sin distinguir mayúsculas)
# TASK_WEBHOOK_RETRY_MS=60000   # cada cuánto reintenta los pendientes (ms)
# TASK_WEBHOOK_RETRY_BASE_MS=60000   # base de la espera creciente entre reintentos (1x, 4x, 9x la base; máx. 3 intentos por evento)

# --- Cobros: a que socio pertenece cada cedula que aparece como "DOCUMENTO V-..." en los comprobantes ---
# Formato "documento=socio" separado por comas. Solo agrega los que falten (lo que edites luego en la app manda).
# Estas son cedulas personales: ponlas SOLO aqui, en el .env del VPS; nunca en el repo ni en documentos.
# RECEIVER_DOCUMENTS=V-00000000=Elis,V-00000000=Jorbi,V-00000000=Leandro

# --- Semaforo de sistemas de los clientes ---
# SYSTEMS_CHECK_MS=600000   # cada cuanto se verifican (ms). 0 apaga el vigilante (la verificacion manual sigue)

# --- Tasa BCV de la barra superior (opcional; ya funciona con los valores por defecto) ---
# BCV_SOURCES=https://ve.dolarapi.com/v1/dolares/oficial,https://ve.dolarapi.com/v1/dolares   # fuentes en orden
# BCV_REFRESH_MS=1800000   # cada cuanto se actualiza sola (ms). 0 la apaga (queda la ultima guardada)

# ANNOUNCE_VERSION=false   # false = no anuncia la version vigente al arrancar (por defecto avisa una sola vez por version)

# --- Mapa del Feed (opcional; sin nada de esto funciona con Nominatim + OpenStreetMap). Ver README, "Mapa del Feed" ---
# GEOCODER=nominatim            # nominatim (por defecto) | mapbox | off
# MAP_TILES=osm                 # osm (por defecto) | mapbox
# MAPBOX_PUBLIC_TOKEN=          # token PUBLICO (pk....) de Mapbox con solo scopes publicos. Solo aqui, en el VPS: nunca en el repo
# MAPBOX_PERMANENT=false        # true = geocodificacion "permanente" de Mapbox (necesaria para GUARDAR resultados; puede requerir plan)
# MAPBOX_STYLE=mapbox/streets-v12

# --- IA del servidor (opcional): acciones sugeridas del Feed y brief del dia del Hub. Llega sola desde GitHub Secrets con el deploy ---
# DEEPSEEK_API_KEY=             # sin ella: no hay acciones sugeridas y el brief se redacta con plantilla. Solo aqui, en el VPS: nunca en el repo
# BRIEF_HORA=6                  # desde que hora (Caracas) se preparan los briefs del dia; BRIEF_CHECK_MS=0 apaga el vigilante
